# Contact form (https://resend.com → API Keys). Copy this file to .env.local and fill it in.
RESEND_API_KEY=
# Where enquiries arrive. Defaults to the email in components/portfolio/data.ts
CONTACT_TO_EMAIL=
# Sender. Leave empty to use Resend's test sender (onboarding@resend.dev), which only
# delivers to your own Resend account email. Once you verify a domain, use e.g.
# "Portfolio <hello@your-domain.com>".
CONTACT_FROM_EMAIL=
