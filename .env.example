# Copy this file to .env.local and fill it in. Never commit .env.local.

# Contact form (https://resend.com → API Keys)
RESEND_API_KEY=
# Where enquiries arrive. Defaults to the email in components/portfolio/data.ts
CONTACT_TO_EMAIL=
# Sender. Empty = Resend's test sender (onboarding@resend.dev), which only delivers to your
# own Resend account email. After verifying a domain: "Mohammad Al Bast <hello@your-domain.com>"
CONTACT_FROM_EMAIL=

# Payload CMS (admin at /admin)
# Neon → your project → Connection string (use the pooled one, it contains "-pooler")
DATABASE_URL=
# Any long random string. Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=

# Cloudflare R2 for uploaded images. Leave empty locally to store uploads in ./media instead.
# R2 → Overview: Account ID
R2_ACCOUNT_ID=
R2_BUCKET=
# R2 → Manage API tokens → Create token with "Object Read & Write" on the bucket
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Public bucket URL (R2 → bucket → Settings → Public access), e.g. https://pub-xxxx.r2.dev
R2_PUBLIC_URL=
